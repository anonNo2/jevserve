  "info": {
    "description": "Development preview: native API and bounded SystemOne compatibility. Text only; no streaming, image inputs, batch jobs or general OpenAI compatibility. Static source contract; live /openapi.json, /docs and /redoc are disabled. JSON Schema cannot express duplicate-key rejection, finite recursive state values, candidate insertion order, probability normalization or ordinal score equations. See docs/api.md and runtime parsers for these additional invariants.",
    "title": "JevServe SystemOne compatibility subset",
    "version": "0.1.0.dev1"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.0",
  "paths": {
    "/livez": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Live; not an inference readiness check",
            "headers": {
              "x-request-id": {
                "description": "Server-generated correlation ID; also present in native/error bodies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "API process liveness"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text exposition",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "unauthorized",
            "headers": {
              "x-request-id": {
                "description": "Server-generated correlation ID; also present in native/error bodies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "summary": "Prometheus metrics"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Ready",
            "headers": {
              "x-request-id": {
                "description": "Server-generated correlation ID; also present in native/error bodies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotReadyResponse"
                }
              }
            },
            "description": "Not ready; health body, not ErrorResponse",
            "headers": {
              "x-request-id": {
                "description": "Server-generated correlation ID; also present in native/error bodies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Runtime readiness"
      }
    },
    "/v1/models": {
      "get": {
        "description": "Metadata is not a readiness or numerical certification claim.",
